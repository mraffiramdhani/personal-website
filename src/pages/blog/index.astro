---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import BlogList from "@/components/BlogList";
import { paginate, normalizePage } from "@/lib/pagination";
import { getPublishedBlogPosts } from "@/lib/blog";
import { CONFIG } from "@/data/config";
import { DATA } from "@/data/resume";

const PAGE_SIZE = CONFIG.blog.postsPerPage;

const sortedPosts = await getPublishedBlogPosts();

const pageParam = Astro.url.searchParams.get("page") ?? undefined;
const totalPages = Math.ceil(sortedPosts.length / PAGE_SIZE);
const currentPage = normalizePage(pageParam, totalPages);
const { items: paginatedPosts, pagination } = paginate(sortedPosts, {
  page: currentPage,
  pageSize: PAGE_SIZE,
});

const posts = paginatedPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  summary: post.data.summary,
  image: post.data.image,
  publishedAt:
		post.data.publishedAt instanceof Date
			? post.data.publishedAt.toISOString()
			: String(post.data.publishedAt),
}));
---

<Layout
  title="Blog"
  description={`Notes from ${DATA.shortName} Ramdhani on JavaScript, TypeScript, and building products.`}
>
  <BlogList
    client:load
    posts={posts}
    allPostsCount={sortedPosts.length}
    pagination={pagination}
    pageSize={PAGE_SIZE}
  />
</Layout>
