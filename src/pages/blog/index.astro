---
export const prerender = true;

import BlogIndex from "@/components/BlogIndex.astro";
import { paginate } from "@/lib/pagination";
import { getPublishedBlogPosts } from "@/lib/blog";
import { CONFIG } from "@/data/config";

const sortedPosts = await getPublishedBlogPosts();
const { items, pagination } = paginate(sortedPosts, {
  page: 1,
  pageSize: CONFIG.blog.postsPerPage,
});
---

<BlogIndex
  posts={items}
  allPostsCount={sortedPosts.length}
  pagination={pagination}
  pageSize={CONFIG.blog.postsPerPage}
/>
