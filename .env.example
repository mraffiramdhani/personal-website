# Copy to `.env` (never commit `.env`).
#
# Local filesystem mode (default):
#   Leave GitHub vars unset. `yarn cms` writes MDX into src/content/blog/.
#
# GitHub mode (commits from the Keystatic UI):
#   1. Set PUBLIC_KEYSTATIC_STORAGE=github
#   2. yarn cms → open /keystatic → Create GitHub App (or create it on GitHub)
#   3. Fill the generated KEYSTATIC_* values below and restart

PUBLIC_GITHUB_REPO_OWNER=mraffiramdhani
PUBLIC_GITHUB_REPO_NAME=personal-website

# Uncomment to switch Keystatic from local files to GitHub commits.
# PUBLIC_KEYSTATIC_STORAGE=github
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Generated when you create the GitHub App. KEYSTATIC_SECRET must be ≥ 32 chars.
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=

# Do not enable on Cloudflare Pages/Workers (Astro 6). See README.
# KEYSTATIC_ENABLE_PRODUCTION=true
